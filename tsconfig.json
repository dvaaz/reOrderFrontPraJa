{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/screens/FichaTecnica/FichaCriarScreen/index.jsx",
    "src/screens/Ingrediente/IngredienteCriarScreen/index.jsx",
    "src/app/(tabs)/index.jsx",
    "src/app/(tabs)/ingrediente.jsx",
    "src/app/(tabs)/_layout.jsx",
    "src/app/_layout.jsx"
, "src/components/fichaScreen/fichaScreen.jsx"  ]
}